{
  "name": "scraperis",
  "version": "1.1.0",
  "description": "Scraperis - Extract Business Data from Scraperis",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron:dev": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder -mw",
    "install-browser": "npx playwright install chromium --with-deps"
  },
  "keywords": [
    "google-maps",
    "scraper",
    "playwright",
    "business-data"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "json2csv": "^6.0.0-alpha.2",
    "playwright": "^1.52.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.sellarisstudio.scraperis",
    "productName": "Scraperis",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "public/images/logo.png",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "public/images/logo.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!user_data/**/*"
    ],
    "asar": false
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  }
}
